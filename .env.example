# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostgreSQL / Prisma
# DATABASE_URL: pooled connection (used by the app at runtime, e.g. Neon's PgBouncer endpoint).
# DIRECT_URL: unpooled connection (required by `prisma migrate deploy`/`migrate dev` — see prisma.config.ts).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/usman_oil_traders?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/usman_oil_traders?schema=public"

# Authentication (NextAuth v5) — REQUIRED, real values, before any deploy. Generate AUTH_SECRET
# with: openssl rand -base64 32. AUTH_TRUST_HOST must be "true" when running behind a proxy
# (Vercel, Caddy, etc.) or NextAuth rejects the forwarded host.
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_TRUST_HOST="true"

# Redis connection — OPTIONAL. If unset, rate limiting on login/checkout/search is disabled
# (see lib/redis.ts); every other feature works normally. Deferred deliberately for initial launch.
REDIS_URL="redis://localhost:6379"

# One-time initial owner bootstrap (never commit real values)
BOOTSTRAP_ADMIN_NAME=""
BOOTSTRAP_ADMIN_USERNAME=""
BOOTSTRAP_ADMIN_PASSWORD=""

# Product-image storage (Cloudflare R2 or S3-compatible) — required before uploading any product
# image (lib/storage.ts); everything else works without it.
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# WhatsApp handoff configuration — optional fallback; the business number is normally set via
# Settings in the admin UI instead (lib/services/settings.service.ts).
WHATSAPP_BUSINESS_PHONE=""
